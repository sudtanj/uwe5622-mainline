# Applied on top of "make allnoconfig" for the arm64 QEMU "virt" guest that
# stands in for the Orange Pi Zero 3 (4x Cortex-A53, 1 or 2 GB): what the
# board's kernel needs for the driver, minus the Allwinner SoC drivers that
# have no QEMU model. tests/qemu/build-kernel.sh fails if olddefconfig drops
# any line of this file.

# Boot: PL011 console, initramfs, SMP with PSCI, no disks
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_HOTPLUG_CPU=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PRINTK_TIME=y

# Modules
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_KALLSYMS=y

# What the three modules import (same set build.yml and
# scripts/build-against-kernel.sh enable on top of defconfig)
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_MMC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_GPIOLIB=y
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# Test plumbing: debugfs, tracepoints for the idle-wakeup metrics, KUnit,
# veth for the simulated chip's peer interface
CONFIG_DEBUG_FS=y
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_KUNIT=y
CONFIG_KUNIT_DEBUGFS=y
CONFIG_VETH=y
CONFIG_SLUB_DEBUG=y
